.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Local AI assistant settings
.claude/settings.local.json
.serena/

# Native Go build artifacts
/ebirogue
/ebirogue.exe

# Web (WASM) build artifacts
/ebirogue.wasm
/public/

# Save and settings files generated at runtime
ebirogue_save.json
ebirogue_settings.json
ebirogue_results.json

# BOT simulation reports (baseline only is tracked)
/reports/*
!/reports/baseline.json

# Local git worktrees for parallel agent work
/.worktrees/

# 画像生成の原画（大きいのでコミットしない。docs/agents/img-content-expansion.md）
tools/*-originals/
